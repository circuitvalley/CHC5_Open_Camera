FX3_INSTALL_PATH ?= ../cyfx3sdk

FX3_LIB_VER  ?= 1_3_5
ARM_GCC_VER  ?= arm-2013.11
ARM_GCC_PATH ?= $(FX3_INSTALL_PATH)/$(ARM_GCC_VER)
FX3_LIB_DIR   = $(FX3_INSTALL_PATH)/fw_lib/$(FX3_LIB_VER)
CC      = $(ARM_GCC_PATH)/bin/arm-none-eabi-gcc
AS      = $(ARM_GCC_PATH)/bin/arm-none-eabi-as
SIZE    = $(ARM_GCC_PATH)/bin/arm-none-eabi-size
ELF2IMG = $(FX3_INSTALL_PATH)/util/elf2img/elf2img
CFLAGS  = -mcpu=arm926ej-s -mthumb-interwork -g -O0 -DTX_ENABLE_EVENT_TRACE -D__CYU3P_TX__ \
          -MMD -MP $(EXTRA_CFLAGS)
ASFLAGS = -mcpu=arm926ej-s -mthumb-interwork
INC = -I. -I$(FX3_LIB_DIR)/inc
LIBS = $(FX3_LIB_DIR)/fx3_release/libcyfxapi.a \
       $(FX3_LIB_DIR)/fx3_release/libcyu3lpp.a \
       $(FX3_LIB_DIR)/fx3_release/libcyu3threadx.a
GIT_SHA    := $(shell git describe --always --abbrev=8 2>/dev/null || echo "unknown")
GIT_DIRTY  := $(shell git diff --quiet 2>/dev/null && echo "" || echo "-dirty")
BUILD_DATE := $(shell date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null || echo "unknown")
GIT_REV    := $(shell git rev-list --count HEAD 2>/dev/null || echo 0)
BUILD_NUM  := $(shell cat .build_number 2>/dev/null || echo 0)
BUILD_NUM  := $(shell echo $$(($(BUILD_NUM) + 1)))
$(shell echo $(BUILD_NUM) > .build_number)
VERGEN = version_gen.h
C_SRC  = cyfxtx.c sensor_chc5.c uvc.c cyfxuvcdscr.c camera_ptzcontrol.c uvc_modes.c led_status.c
AS_SRC = cyfx_gcc_startup.S
OBJS   = $(AS_SRC:.S=.o) $(C_SRC:.c=.o)
DEPS   = $(C_SRC:.c=.d)
TARGET = firmware
all: $(VERGEN) $(TARGET).img
	@echo ""
	@echo "=== Build complete ==="
	@echo "  Binary : $(TARGET).img ($(shell stat -c%s $(TARGET).img) bytes)"
	@echo "  Version: $(GIT_SHA)$(GIT_DIRTY) rev $(GIT_REV) build $(BUILD_NUM)"
	@$(SIZE) $(TARGET).elf
$(VERGEN): FORCE
	@echo "/* Auto-generated by Makefile - do not edit */" > $@.tmp
	@echo "#define FW_GIT_SHA      \"$(GIT_SHA)\"" >> $@.tmp
	@echo "#define FW_GIT_DIRTY    \"$(GIT_DIRTY)\"" >> $@.tmp
	@echo "#define FW_BUILD_DATE   \"$(BUILD_DATE)\"" >> $@.tmp
	@echo "#define FW_GIT_REV      $(GIT_REV)" >> $@.tmp
	@echo "#define FW_BUILD_NUM    $(BUILD_NUM)" >> $@.tmp
	@cmp -s $@.tmp $@ 2>/dev/null || mv $@.tmp $@
	@rm -f $@.tmp
FORCE:
$(TARGET).img: $(TARGET).elf
	$(ELF2IMG) -i $(TARGET).elf -o $(TARGET).img -vectorload yes
$(TARGET).elf: $(OBJS)
	$(CC) $(CFLAGS) -T $(FX3_INSTALL_PATH)/fw_build/fx3_fw/fx3.ld -o $@ $(OBJS) $(LIBS) -lc -lgcc
%.o: %.c
	$(CC) $(CFLAGS) $(INC) -c $< -o $@
%.o: %.S
	$(AS) $(ASFLAGS) -c $< -o $@
-include $(DEPS)
clean:
	rm -f *.o *.d $(TARGET).elf $(TARGET).img $(VERGEN) $(VERGEN).tmp
distclean: clean
	rm -f .build_number
.PHONY: all clean distclean FORCE
