CROSS_COMPILE  ?= arm-linux-gnueabihf-
CC             := $(CROSS_COMPILE)gcc
AR             := $(CROSS_COMPILE)ar
STRIP          := $(CROSS_COMPILE)strip

SYSROOT ?=

KERNEL_DIR ?=
ifneq ($(KERNEL_DIR),)
  KERN_INC = -I$(KERNEL_DIR)
else ifneq ($(SYSROOT),)
  KERN_INC = --sysroot=$(SYSROOT)
else
  KERN_INC =
endif

GIT_SHA    := $(shell git describe --always --abbrev=8 2>/dev/null || echo "unknown")
GIT_DIRTY  := $(shell git diff --quiet 2>/dev/null && echo "" || echo "-dirty")
BUILD_DATE := $(shell date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null || echo "unknown")
GIT_REV    := $(shell git rev-list --count HEAD 2>/dev/null || echo 0)
BUILD_NUM  := $(shell cat .build_number 2>/dev/null || echo 0)
BUILD_NUM  := $(shell echo $$(($(BUILD_NUM) + 1)))
$(shell echo $(BUILD_NUM) > .build_number)

VERGEN    = $(BUILD_DIR)version_gen.h

override CFLAGS  += -O2 -Wall -Wextra -Wno-unused-parameter -std=gnu11 \
                    -march=armv7-a -mfpu=neon -mfloat-abi=hard \
                    -MMD -MP \
                    $(KERN_INC) \
                    -I$(if $(BUILD_DIR),$(BUILD_DIR),.) \
                    $(EXTRA_CFLAGS)

override LDFLAGS += $(EXTRA_LDFLAGS)
LDLIBS  ?= -lpthread -lm

HAVE_SYSTEMD ?= 1
ifeq ($(HAVE_SYSTEMD),1)
  override CFLAGS += -DHAVE_SYSTEMD
  LDLIBS          += -lsystemd
endif

BUILD_DIR ?=
ifneq ($(BUILD_DIR),)
  _dummy := $(shell mkdir -p $(BUILD_DIR))
endif

DAEMON_SRCS = main.c config.c usb_monitor.c \
              ipc_server.c media_pipeline.c genconv.c \
              ccm_util.c imaging_pub.c camio_sync.c camio_pub.c
DAEMON_OBJS = $(addprefix $(BUILD_DIR),$(DAEMON_SRCS:.c=.o))
DAEMON_BIN  = $(BUILD_DIR)camcfgd

CLIENT_SRCS = camcfgd_client.c
CLIENT_OBJS = $(addprefix $(BUILD_DIR),$(CLIENT_SRCS:.c=.o))
CLIENT_LIB  = $(BUILD_DIR)libcamcfgd_client.a

all: $(VERGEN) $(DAEMON_BIN) $(CLIENT_LIB)
	@echo ""
	@echo "=== Build complete ==="
	@echo "  Daemon : $(DAEMON_BIN)"
	@echo "  Library: $(CLIENT_LIB)"
	@echo "  Version: $(GIT_SHA)$(GIT_DIRTY) rev $(GIT_REV) build $(BUILD_NUM)"
	@echo "  Target : $$($(CC) -dumpmachine 2>/dev/null || echo unknown)"
	@echo "  Sysroot: $(SYSROOT)"
	@file $(DAEMON_BIN) 2>/dev/null || true

.PHONY: version_gen
version_gen: $(VERGEN)

$(VERGEN): FORCE
	@echo "/* Auto-generated by Makefile -- do not edit */" > $@.tmp
	@echo "#define CAMCFGD_GIT_SHA      \"$(GIT_SHA)\"" >> $@.tmp
	@echo "#define CAMCFGD_GIT_DIRTY    \"$(GIT_DIRTY)\"" >> $@.tmp
	@echo "#define CAMCFGD_BUILD_DATE   \"$(BUILD_DATE)\"" >> $@.tmp
	@echo "#define CAMCFGD_GIT_REV      $(GIT_REV)" >> $@.tmp
	@echo "#define CAMCFGD_BUILD_NUM    $(BUILD_NUM)" >> $@.tmp
	@cmp -s $@.tmp $@ 2>/dev/null || mv $@.tmp $@
	@rm -f $@.tmp

FORCE:

$(DAEMON_BIN): $(DAEMON_OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS) $(LDLIBS)

$(CLIENT_LIB): $(CLIENT_OBJS)
	$(AR) rcs $@ $^

$(BUILD_DIR)%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

check: $(DAEMON_BIN)
	@echo "--- Binary ---"
	@file $(DAEMON_BIN)
	@echo ""
	@echo "--- Dynamic libs ---"
	@$(CROSS_COMPILE)readelf -d $(DAEMON_BIN) 2>/dev/null | grep NEEDED || true
	@echo ""
	@echo "--- Size ---"
	@$(CROSS_COMPILE)size $(DAEMON_BIN) 2>/dev/null || true

clean:
	rm -f $(DAEMON_OBJS) $(CLIENT_OBJS) $(DAEMON_BIN) $(CLIENT_LIB)
	rm -f $(DAEMON_OBJS:.o=.d) $(CLIENT_OBJS:.o=.d)
	rm -f $(VERGEN) $(VERGEN).tmp
	rm -f *.o *.d

distclean: clean
	rm -f .build_number

strip: $(DAEMON_BIN)
	$(STRIP) $(DAEMON_BIN)
	@ls -lh $(DAEMON_BIN)

DESTDIR ?=

install: $(DAEMON_BIN) $(CLIENT_LIB)
	install -d $(DESTDIR)/usr/bin
	install -d $(DESTDIR)/usr/lib
	install -d $(DESTDIR)/usr/include/camcfgd
	install -m 755 $(DAEMON_BIN)    $(DESTDIR)/usr/bin/
	install -m 644 $(CLIENT_LIB)    $(DESTDIR)/usr/lib/
	install -m 644 camcfgd_client.h $(DESTDIR)/usr/include/camcfgd/
	install -m 644 common.h         $(DESTDIR)/usr/include/camcfgd/
	@echo ""
	@echo "Installed to $(DESTDIR)/:"
	@echo "  /usr/bin/camcfgd"
	@echo "  /usr/lib/libcamcfgd_client.a"
	@echo "  /usr/include/camcfgd/{camcfgd_client.h,common.h}"

install-service: camcfgd.service
	install -d $(DESTDIR)/etc/systemd/system
	install -m 644 camcfgd.service $(DESTDIR)/etc/systemd/system/
	@echo "Installed: $(DESTDIR)/etc/systemd/system/camcfgd.service"

install-all: install install-service

-include $(DAEMON_OBJS:.o=.d) $(CLIENT_OBJS:.o=.d)

$(BUILD_DIR)main.o: $(VERGEN)

.PHONY: all clean distclean strip check install install-service install-all
