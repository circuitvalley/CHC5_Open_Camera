  </EnumEntry>
  <EnumEntry Name="YCbCr422_8">
   <Value>34603067</Value>
  </EnumEntry>
  <EnumEntry Name="RGB565p">
   <Value>34603061</Value>
  </EnumEntry>
  <pIsLocked>TLParamsLockedAcq</pIsLocked>
  <pValue>PixelFormatReg</pValue>
 </Enumeration>

 <IntReg Name="PixelFormatReg">
  <Address>0x05000008</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Integer Name="SensorWidth">
  <ToolTip>Effective width of the sensor in pixels</ToolTip>
  <pValue>SensorWidthReg</pValue>
 </Integer>

 <IntReg Name="SensorWidthReg">
  <Address>0x05000024</Address>
  <Length>4</Length>
  <AccessMode>RO</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Integer Name="SensorHeight">
  <ToolTip>Effective height of the sensor in pixels</ToolTip>
  <pValue>SensorHeightReg</pValue>
 </Integer>

 <IntReg Name="SensorHeightReg">
  <Address>0x05000028</Address>
  <Length>4</Length>
  <AccessMode>RO</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Enumeration Name="TestPattern">
  <ToolTip>Selects the test pattern generator</ToolTip>
  <EnumEntry Name="Off">
   <Value>0</Value>
  </EnumEntry>
  <EnumEntry Name="GreyHorizontalRamp">
   <Value>1</Value>
  </EnumEntry>
  <EnumEntry Name="GreyVerticalRamp">
   <Value>2</Value>
  </EnumEntry>
  <EnumEntry Name="ColorBar">
   <Value>3</Value>
  </EnumEntry>
  <pValue>TestPatternReg</pValue>
 </Enumeration>

 <IntReg Name="TestPatternReg">
  <Address>0x05000034</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>


 <Enumeration Name="AcquisitionMode">
  <ToolTip>Sets the acquisition mode</ToolTip>
  <EnumEntry Name="Continuous">
   <Value>0</Value>
  </EnumEntry>
  <EnumEntry Name="SingleFrame">
   <Value>1</Value>
  </EnumEntry>
  <pValue>AcquisitionModeReg</pValue>
 </Enumeration>

 <IntReg Name="AcquisitionModeReg">
  <Address>0x05000010</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Command Name="AcquisitionStart">
  <ToolTip>Starts the acquisition of images</ToolTip>
  <CommandValue>1</CommandValue>
  <pValue>AcquisitionStartReg</pValue>
 </Command>

 <IntReg Name="AcquisitionStartReg">
  <Address>0x05000014</Address>
  <Length>4</Length>
  <AccessMode>WO</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Command Name="AcquisitionStop">
  <ToolTip>Stops the acquisition of images</ToolTip>
  <CommandValue>1</CommandValue>
  <pValue>AcquisitionStopReg</pValue>
 </Command>

 <IntReg Name="AcquisitionStopReg">
  <Address>0x05000018</Address>
  <Length>4</Length>
  <AccessMode>WO</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Float Name="ExposureTime">
  <ToolTip>Exposure time in microseconds</ToolTip>
  <Description>Sets the exposure time in microseconds.</Description>
  <pValue>ExposureTimeReg</pValue>
  <Min>10</Min>
  <Max>1000000</Max>
  <Unit>us</Unit>
  <Representation>Logarithmic</Representation>
  <DisplayNotation>Fixed</DisplayNotation>
  <DisplayPrecision>1</DisplayPrecision>
 </Float>

 <IntReg Name="ExposureTimeReg">
  <Address>0x05000030</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Enumeration Name="ExposureAuto">
  <ToolTip>Sets the automatic exposure control mode</ToolTip>
  <Description>Controls whether exposure time is adjusted automatically by the device. Off means manual control via ExposureTime.</Description>
  <EnumEntry Name="Off">
   <Value>0</Value>
  </EnumEntry>
  <EnumEntry Name="Once">
   <Value>1</Value>
  </EnumEntry>
  <EnumEntry Name="Continuous">
   <Value>2</Value>
  </EnumEntry>
  <pValue>ExposureAutoReg</pValue>
 </Enumeration>

 <IntReg Name="ExposureAutoReg">
  <Address>0x05000044</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Float Name="AcquisitionFrameRate">
  <ToolTip>Acquisition frame rate in frames per second</ToolTip>
  <Description>Controls the acquisition rate (in frames per second) at which the frames are captured.</Description>
  <pValue>AcquisitionFrameRateReg</pValue>
  <Min>1</Min>
  <Max>4000</Max>
  <Unit>Hz</Unit>
  <Representation>Linear</Representation>
  <DisplayNotation>Fixed</DisplayNotation>
  <DisplayPrecision>1</DisplayPrecision>
 </Float>

 <IntReg Name="AcquisitionFrameRateReg">
  <Address>0x05000038</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Boolean Name="AcquisitionFrameRateEnable">
  <ToolTip>Enables setting the camera's acquisition frame rate to a specified value</ToolTip>
  <Description>When enabled, the camera limits the frame rate to the AcquisitionFrameRate value. When disabled, the camera runs at the maximum frame rate possible for the current settings.</Description>
  <pValue>AcquisitionFrameRateEnableReg</pValue>
 </Boolean>

 <IntReg Name="AcquisitionFrameRateEnableReg">
  <Address>0x0500003C</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>


 <Float Name="Gain">
  <ToolTip>Analog gain in dB (0 dB = unity gain)</ToolTip>
  <Description>Sets the analog gain in decibels. 0 dB means unity gain (no amplification). For best image quality, use small gain values and increase ExposureTime instead.</Description>
  <pValue>GainConv</pValue>
  <Min>0.0</Min>
  <Max>72.0</Max>
  <Unit>dB</Unit>
  <Representation>Linear</Representation>
  <DisplayNotation>Fixed</DisplayNotation>
  <DisplayPrecision>1</DisplayPrecision>
 </Float>

 <Converter Name="GainConv">
  <FormulaTo>FROM * 10</FormulaTo>
  <FormulaFrom>TO / 10</FormulaFrom>
  <pValue>GainReg</pValue>
  <Slope>Automatic</Slope>
 </Converter>

 <IntReg Name="GainReg">
  <Address>0x0500002C</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Float Name="BlackLevel">
  <ToolTip>Black level offset in raw sensor units</ToolTip>
  <Description>Controls the analog black level as an offset. Increasing this value will make the image brighter in the dark areas.</Description>
  <pValue>BlackLevelReg</pValue>
  <Min>0</Min>
  <Max>4095</Max>
  <Representation>Linear</Representation>
  <DisplayNotation>Fixed</DisplayNotation>
  <DisplayPrecision>0</DisplayPrecision>
 </Float>

 <IntReg Name="BlackLevelReg">
  <Address>0x05000040</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Boolean Name="GammaEnable">
  <ToolTip>Enables the gamma correction</ToolTip>
  <Description>Off gives linear output: the gamma curve is bypassed.</Description>
  <DisplayName>Gamma Enable</DisplayName>
  <Streamable>Yes</Streamable>
  <pValue>GammaEnableReg</pValue>
 </Boolean>

 <IntReg Name="GammaEnableReg">
  <Address>0x050000B0</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Enumeration Name="GammaSelector">
  <ToolTip>Selects the type of gamma to apply</ToolTip>
  <DisplayName>Gamma Selector</DisplayName>
  <Streamable>Yes</Streamable>
  <EnumEntry Name="User">
   <ToolTip>Sets gamma to user defined curve</ToolTip>
   <Value>1</Value>
  </EnumEntry>
  <EnumEntry Name="sRGB">
   <ToolTip>Sets gamma to fixed sRGB curve</ToolTip>
   <Value>2</Value>
  </EnumEntry>
  <pValue>GammaSelectorReg</pValue>
 </Enumeration>

 <IntReg Name="GammaSelectorReg">
  <Address>0x050000B4</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Float Name="Gamma">
  <ToolTip>This feature is used to perform gamma correction of pixel intensity.</ToolTip>
  <Description>Used when GammaSelector is User: Output = Input^Gamma. 1.0 is linear, below 1 brightens.</Description>
  <Streamable>Yes</Streamable>
  <pValue>GammaConv</pValue>
  <Min>0.25</Min>
  <Max>4.0</Max>
  <Representation>Linear</Representation>
  <DisplayNotation>Fixed</DisplayNotation>
  <DisplayPrecision>2</DisplayPrecision>
 </Float>

 <Converter Name="GammaConv">
  <FormulaTo>FROM * 100 + 0.5</FormulaTo>
  <FormulaFrom>TO / 100</FormulaFrom>
  <pValue>GammaReg</pValue>
  <Slope>Increasing</Slope>
 </Converter>

 <IntReg Name="GammaReg">
  <Address>0x050000B8</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Enumeration Name="GainAuto">
  <ToolTip>Sets the automatic gain control mode</ToolTip>
  <Description>Controls whether gain is adjusted automatically by the device. Off means manual control via Gain.</Description>
  <EnumEntry Name="Off">
   <Value>0</Value>
  </EnumEntry>
  <EnumEntry Name="Once">
   <Value>1</Value>
  </EnumEntry>
  <EnumEntry Name="Continuous">
   <Value>2</Value>
  </EnumEntry>
  <pValue>GainAutoReg</pValue>
 </Enumeration>

 <IntReg Name="GainAutoReg">
  <Address>0x05000048</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Enumeration Name="BalanceWhiteAuto">
  <ToolTip>Sets the automatic white balance control mode</ToolTip>
  <Description>Controls whether white balance is adjusted automatically by the device.</Description>
  <EnumEntry Name="Off">
   <Value>0</Value>
  </EnumEntry>
  <EnumEntry Name="Once">
   <Value>1</Value>
  </EnumEntry>
  <EnumEntry Name="Continuous">
   <Value>2</Value>
  </EnumEntry>
  <pValue>BalanceWhiteAutoReg</pValue>
 </Enumeration>

 <IntReg Name="BalanceWhiteAutoReg">
  <Address>0x0500004C</Address>
  <Length>4</Length>
  <AccessMode>RW</AccessMode>
  <pPort>Device</pPort>
  <Sign>Unsigned</Sign>
  <Endianness>LittleEndian</Endianness>
 </IntReg>

 <Enumeration Name="BalanceRatioSelector">
  <ToolTip>Selects which colour channel BalanceRatio adjusts</ToolTip>
  <EnumEntry Name="Red"><Value>0</Value></EnumEntry>
  <EnumEntry Name="Green"><Value>1</Value></EnumEntry>
  <EnumEntry Name="Blue"><Value>2</Value></EnumEntry>
  <pValue>BalanceRatioSelectorReg</pValue>
 </Enumeration>
 <IntReg Name="BalanceRatioSelectorReg">
  <Address>0x05000080</Address><Length>4</Length><AccessMode>RW</AccessMode>
  <pPort>Device</pPort><Sign>Unsigned</Sign><Endianness>LittleEndian</Endianness>
 </IntReg>

 <Integer Name="BalanceRatioRaw">
  <ToolTip>Manual white-balance gain for the selected channel, U8.8 (256 = 1.0)</ToolTip>
  <Value>256</Value><Min>16</Min><Max>4096</Max><Inc>1</Inc>
  <pValue>BalanceRatioReg</pValue>
 </Integer>
 <IntReg Name="BalanceRatioReg">
  <Address>0x05000084</Address><Length>4</Length><AccessMode>RW</AccessMode>
  <pPort>Device</pPort><Sign>Unsigned</Sign><Endianness>LittleEndian</Endianness>
 </IntReg>

 <Integer Name="BalanceWhiteAutoLowerLimitRaw">
  <ToolTip>AWB min per-channel gain, U8.8 (0 = device default)</ToolTip>
  <Value>0</Value><Min>0</Min><Max>256</Max><Inc>1</Inc>
  <pValue>AwbLowerLimitReg</pValue>
 </Integer>
 <IntReg Name="AwbLowerLimitReg">
  <Address>0x05000088</Address><Length>4</Length><AccessMode>RW</AccessMode>
  <pPort>Device</pPort><Sign>Unsigned</Sign><Endianness>LittleEndian</Endianness>
 </IntReg>
 <Integer Name="BalanceWhiteAutoUpperLimitRaw">
  <ToolTip>AWB max per-channel gain, U8.8/16 (0 = device default)</ToolTip>
  <Value>0</Value><Min>0</Min><Max>160</Max><Inc>1</Inc>
  <pValue>AwbUpperLimitReg</pValue>
 </Integer>
 <IntReg Name="AwbUpperLimitReg">
  <Address>0x0500008C</Address><Length>4</Length><AccessMode>RW</AccessMode>
