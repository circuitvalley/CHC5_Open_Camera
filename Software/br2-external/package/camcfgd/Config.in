config BR2_PACKAGE_CAMCFGD
	bool "camcfgd"
	depends on BR2_INIT_SYSTEMD
	depends on BR2_USE_MMU
	help
	  CHC5 Open Camera runtime-configuration daemon (gain, exposure, format,.

comment "camcfgd needs systemd"
	depends on !BR2_INIT_SYSTEMD
