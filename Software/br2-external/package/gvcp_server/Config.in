config BR2_PACKAGE_GVCP_SERVER
	bool "gvcp_server"
	depends on BR2_INIT_SYSTEMD
	depends on BR2_USE_MMU
	help
	  CHC5 Open Camera GigE Vision Control Protocol server.

comment "gvcp_server needs systemd"
	depends on !BR2_INIT_SYSTEMD
