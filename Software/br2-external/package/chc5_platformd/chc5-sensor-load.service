[Unit]
Description=CHC5 -- Apply staged sensor overlay at boot
DefaultDependencies=no
After=systemd-modules-load.service
After=local-fs.target
After=sys-kernel-config.mount
After=chc5_platformd.service
Wants=chc5_platformd.service
ConditionPathExists=/var/lib/chc5_platformd/sensors/.current

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/chc5-sensor-load
StandardOutput=journal
StandardError=journal

TimeoutStartSec=15s

[Install]
WantedBy=basic.target
