[Unit]
Description=CHC5 PTP mode: Zynq GEM clock follows the PHY clock (phc2sys)
Documentation=file:/usr/lib/chc5/chc5-ptp.sh
BindsTo=chc5-ptp.service
After=chc5-ptp.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/lib/chc5/chc5-ptp.sh phc2sys
Restart=on-failure
RestartSec=2
