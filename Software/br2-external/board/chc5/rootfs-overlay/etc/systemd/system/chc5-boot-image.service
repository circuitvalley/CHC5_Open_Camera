[Unit]
Description=CHC5 boot-image check (which BOOT.BIN copy the BootROM used; warn on golden)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target chc5_webd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/chc5/boot-image-check.sh

[Install]
WantedBy=sysinit.target
