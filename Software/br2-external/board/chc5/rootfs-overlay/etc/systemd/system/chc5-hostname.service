[Unit]
Description=CHC5 persist per-unit hostname across boots (read-only root)
DefaultDependencies=no
After=var.mount local-fs.target
RequiresMountsFor=/var
Before=systemd-networkd.service dbus.service sysinit.target
ConditionPathIsReadWrite=!/

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/chc5/hostname-persist.sh

[Install]
WantedBy=sysinit.target
