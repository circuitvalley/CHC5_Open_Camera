[Unit]
Description=CHC5 persist machine-id across boots (read-only root)
DefaultDependencies=no
After=var.mount local-fs.target
RequiresMountsFor=/var
Before=systemd-networkd.service systemd-networkd-wait-online.service dbus.service sysinit.target
ConditionPathIsReadWrite=!/

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/chc5/machine-id-persist.sh

[Install]
WantedBy=sysinit.target
