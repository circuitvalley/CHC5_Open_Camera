[Unit]
Description=CHC5 interrupt placement (FX3 mailbox and GigE frame done on CPU1)
Documentation=file:/usr/lib/chc5/chc5-irq-affinity.sh
After=chc5-sensor-load.service systemd-udevd.service systemd-udev-trigger.service
Before=camcfgd.service gvcp_server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/chc5/chc5-irq-affinity.sh

[Install]
WantedBy=multi-user.target
