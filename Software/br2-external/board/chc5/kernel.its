/dts-v1/;
/ {
	description = "CHC5 kernel FIT (zImage + DTB)";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux zImage";
			data = /incbin/("./zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x00208000>;
			entry = <0x00208000>;
			hash-1 { algo = "sha256"; };
		};
		fdt {
			description = "zynq-chc5 devicetree";
			data = /incbin/("./zynq-chc5.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "conf";
		conf {
			description = "CHC5 default";
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
